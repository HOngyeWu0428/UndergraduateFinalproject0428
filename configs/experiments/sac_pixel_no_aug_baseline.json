{
  "experiment_name": "sac_pixel_no_aug_baseline",
  "env": {
    "env_id": "CarRacing-v3",
    "image_size": 84,
    "frame_stack": 3
  },
  "augmentation": {
    "name": "none",
    "pad": 0
  },
  "train": {
    "total_steps": 100000,
    "seed": 1,
    "batch_size": 128,
    "start_steps": 5000,
    "update_after": 1000,
    "update_every": 1,
    "eval_interval": 5000,
    "eval_episodes": 5,
    "replay_capacity": 100000,
    "gamma": 0.99,
    "tau": 0.01,
    "lr": 0.0003,
    "alpha_lr": 0.0003,
    "init_temperature": 0.1
  },
  "model": {
    "feature_dim": 50,
    "hidden_dim": 1024,
    "log_std_min": -10.0,
    "log_std_max": 2.0
  },
  "output": {
    "run_dir": "runs",
    "checkpoint_interval": 10000,
    "log_interval": 1000,
    "use_tensorboard": true
  }
}
